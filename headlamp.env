# The Headlamp this repo's image is built from. Editing this file rebuilds the image.
# HEADLAMP_REPO must be public. HEADLAMP_TAG is the image tag published to
# ghcr.io/risingtidegroup/headlamp (it moves with each build; a pinned
# <tag>-<headlamp sha7>-<plugins sha7> tag is published alongside).
HEADLAMP_REPO=pivotal-crew/headlamp
HEADLAMP_REF=pivotal/v0.46.0
HEADLAMP_TAG=pivotal-v0.46.0
